{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "Chooser Toolset",
	"Description": "AI assistant tools for authoring Chooser Tables: table signature and parameters, rows and results, filter/scoring/output columns, cell values, nested choosers, and test evaluation.",
	"Category": "Gameplay",
	"CreatedBy": "Kazarin Dmitry Dmitrievich",
	"CreatedByURL": "https://github.com/iEclisse",
	"DocsURL": "https://github.com/iEclisse/ChooserToolset",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/iEclisse/ChooserToolset/issues",
	"EditorOnly": true,
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "ChooserToolset",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"TargetAllowList": [ "Editor" ]
		}
	],
	"Plugins": [
		{
			"Name": "ToolsetRegistry",
			"Enabled": true
		},
		{
			"Name": "Chooser",
			"Enabled": true
		}
	]
}
